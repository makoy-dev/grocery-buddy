{
  "expo": {
    "name": "Grocery Godz",
    "slug": "grocery-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/grocery-godz-bg.png",
    "scheme": "grocerybuddy",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.grocerygodz.grocerybuddy",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E8771B",
        "foregroundImage": "./assets/images/grocery-godz-bg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8771B",
          "image": "./assets/images/grocery-godz-bg.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Grocery Godz to scan grocery barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6042b129-be00-4349-9545-31a78d071aab"
      }
    },
    "owner": "makoy696"
  }
}
